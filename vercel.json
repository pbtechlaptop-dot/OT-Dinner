{
  "version": 2,
  "routes": [
    { "src": "^/api/(.*)$", "dest": "/api/index.js" },
    { "src": "^/lady-ruby/?$", "dest": "/api/index.js" },
    { "src": "^/new/?$", "dest": "/New/index.html" },
    { "src": "^/new/(.*)$", "dest": "/New/$1" },
    { "src": "^/$", "dest": "/public/index.html" },
    { "src": "^/admin/?$", "dest": "/public/admin.html" },
    { "src": "^/(.*)$", "dest": "/public/$1" }
  ]
}
